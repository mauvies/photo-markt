# ==========================================
# .claudeignore - Photo Markt
# Objetivo: Ahorrar tokens y evitar fugas de secretos.
# ==========================================

# --- Dependencias (¡El mayor ahorro!) ---
node_modules/
jspm_packages/
web_modules/

# --- Directorios de Build y Output ---
.next/
build/
dist/
out/
.cache/

# --- Variables de Entorno y Secretos (¡CRÍTICO!) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
auth_token*
secrets.json

# --- Logs y Archivos Temporales ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
.stylelintcache
*.log
*.tmp
*.temp

# --- Multimedia y Assets Grandes ---
# Claude no lee binarios — ignorar ahorra tokens significativos
public/assets/
public/images/
public/videos/
public/fonts/
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.mp4
*.webp
*.avif
*.ttf
*.otf
# SVGs NO ignorados — pueden ser componentes relevantes en el código

# --- Base de Datos ---
*.db
*.sqlite
*.sqlite-journal
# NO ignorar *.sql — las migraciones en /supabase/migrations/ son necesarias
# para que Claude entienda el schema y escriba migraciones correctas

# --- Supabase local ---
supabase/.branches/
supabase/.temp/

# --- Configuración de IDEs ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/

# --- Control de Versiones ---
.git/
.hg/
.svn/

# --- Coverage y Tests ---
coverage/
.nyc_output/
__snapshots__/

# --- Deploy y CI ---
.vercel/
.turbo/

# --- Lock files (muy largos, no aportan contexto útil) ---
pnpm-lock.yaml
package-lock.json
yarn.lock
