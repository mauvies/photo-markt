NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AMATEUR=
STRIPE_PRICE_PRO=

RESEND_API_KEY=

# AWS Rekognition (face indexing). Region defaults to eu-west-1 — staging
# and prod both run there today. Credentials are required for the
# Inngest worker to call AWS; in tests they're fake strings.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prefix on every Rekognition collection id. Lets us namespace per env
# (e.g. `photomarkt-staging-event-{uuid}` vs `-production-event-`).
REKOGNITION_COLLECTION_PREFIX=photomarkt-dev
# Inngest credentials. EVENT_KEY signs outbound `inngest.send()` calls,
# SIGNING_KEY verifies inbound webhook payloads to /api/inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google Places API key — used ONLY by the LocationAutocomplete component in event
# creation and editing forms. Without it the component falls back to mock suggestions.
# The main event search bar does NOT use this key (it queries Supabase directly).
#
# Manual Google Cloud Console steps (do not automate):
#   1. Enable "Places API" in photomarkt-staging and photomarkt-prod projects.
#   2. Restrict the key to HTTP referrers:
#      https://photomarkt.com/*
#      https://www.photomarkt.com/*
#      http://localhost:3000/*
#   3. Restrict the key under "API restrictions" to BOTH:
#        - Maps JavaScript API  (loads the SDK)
#        - Places API           (the actual autocomplete calls)
#      The legacy `AutocompleteService` won't load without Maps JavaScript API
#      allowed — you'll get ApiTargetBlockedMapError otherwise.
#   4. Set daily quota: 1,000 req/day (staging), 5,000 req/day (prod).
#   5. Add NEXT_PUBLIC_GOOGLE_PLACES_API_KEY to Vercel env vars for both environments.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
RESEND_FROM_EMAIL=noreply@photomarkt.com

AI_PROVIDER=
PLATFORM_FEE_BPS=
SITE_URL=

# Shared secret for the readiness endpoint GET /api/health/ready (T-044).
# When unset the endpoint stays locked (401). Pass it as ?token=, a Bearer
# token, or the x-health-token header. Point your external uptime monitor here.
HEALTH_CHECK_TOKEN=