{
  "name": "photomarkt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "supabase start && (vitest run test/integration; ec=$?; supabase stop; exit $ec)",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:seed": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -f supabase/seed.sql",
    "format": "biome format --write",
    "format:fix": "biome format --write",
    "typecheck": "tsc --noEmit",
    "spell": "cspell --quiet **/*.ts **/*.tsx",
    "watermark:gen": "tsx scripts/gen-watermark.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1074.0",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@sentry/nextjs": "^10.59.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "inngest": "^4.7.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.6",
    "react": "19.2.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.1",
    "react-photo-album": "^3.6.0",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.8.1",
    "resend": "^6.14.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "20.4.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@cspell/dict-es-es": "^3.0.8",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^7.0.0",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "^10.0.1",
    "happy-dom": "^20.10.6",
    "supabase": "2.107.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@sentry/cli",
      "@tailwindcss/oxide",
      "esbuild",
      "protobufjs",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  }
}
