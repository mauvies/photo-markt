{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    // Explicit since TypeScript 6: dotted packages under node_modules/@types
    // (`@types/google.maps`, source of the ambient `google` namespace) are no
    // longer auto-included in the program. `node` must be listed too — setting
    // `types` disables auto-inclusion for every global @types package.
    // Import-resolved types (react, react-dom, archiver) need no entry.
    "types": ["node", "google.maps"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/env.mjs": ["./env.mjs"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
